def @sched_looptick() {
  @bench_begin();
  repeat 5 {
    sc_n = 0;
    b_t0 = daysSince2000();
    until (daysSince2000() - b_t0) * 86400000 >= b_budget {
      sc_n += 1;
    }
    b_t1 = daysSince2000();
    b_n = sc_n;
    @bench_round();
  }
  b_chk = b_n;
  @bench_end("sched_looptick", 1);
}

def @sched_pingpong() {
  @bench_begin();
  repeat 5 {
    sc_hits = 0;
    b_t0 = daysSince2000();
    until (daysSince2000() - b_t0) * 86400000 >= b_budget {
      broadcast_wait sc_ping;
    }
    b_t1 = daysSince2000();
    b_n = sc_hits;
    @bench_round();
  }
  b_chk = b_n;
  @bench_end("sched_pingpong", 1);
}

def @sched_restart() {
  @bench_begin();
  repeat 5 {
    sc_n = 0;
    b_t0 = daysSince2000();
    until (daysSince2000() - b_t0) * 86400000 >= b_budget {
      broadcast sc_long;
      sc_n += 1;
    }
    b_t1 = daysSince2000();
    b_n = sc_n;
    broadcast_wait sc_long;
    @bench_round();
  }
  b_chk = b_n;
  @bench_end("sched_restart", 1);
}

def @sched_clonechurn() {
  @bench_begin();
  repeat 5 {
    sc_hits = 0;
    k_n = 0;
    b_t0 = daysSince2000();
    until (daysSince2000() - b_t0) * 86400000 >= b_budget {
      k_n += 100;
      repeat 100 {
        clone "Churn";
      }
      wait_until sc_hits == k_n;
    }
    b_t1 = daysSince2000();
    b_n = sc_hits;
    @bench_round();
  }
  b_chk = b_n;
  @bench_end("sched_clonechurn", 1);
}

def @sched_spawn() {
  sc_ready = 0;
  repeat 100 {
    clone "Worker";
  }
  wait_until sc_ready == 100;
}

def @sched_threads() {
  @bench_begin();
  repeat 5 {
    sc_n = 0;
    sc_stop = 0;
    sc_done = 0;
    b_t0 = daysSince2000();
    broadcast sc_run;
    wait_until (daysSince2000() - b_t0) * 86400000 >= b_budget;
    b_t1 = daysSince2000();
    b_n = sc_n;
    sc_stop = 1;
    wait_until sc_done == 101;
    @bench_round();
  }
  b_chk = b_n;
  @bench_end("sched_threads", 1);
}

def @sched_fanout() {
  @bench_begin();
  repeat 5 {
    sc_hits = 0;
    k_n = 0;
    b_t0 = daysSince2000();
    until (daysSince2000() - b_t0) * 86400000 >= b_budget {
      broadcast sc_fan;
      k_n += 101;
    }
    wait_until sc_hits == k_n;
    b_t1 = daysSince2000();
    b_n = sc_hits;
    @bench_round();
  }
  b_chk = b_n;
  @bench_end("sched_fanout", 1);
}

def @sched_fanwait() {
  @bench_begin();
  repeat 5 {
    sc_hits = 0;
    b_t0 = daysSince2000();
    until (daysSince2000() - b_t0) * 86400000 >= b_budget {
      broadcast_wait sc_fan;
    }
    b_t1 = daysSince2000();
    b_n = sc_hits;
    @bench_round();
  }
  b_chk = b_n;
  @bench_end("sched_fanwait", 1);
}

def @sched_waituntil() {
  @bench_begin();
  repeat 5 {
    sc_gate = 0;
    sc_n = 0;
    k_n = 0;
    broadcast sc_poll;
    repeat 3 {
      sc_tick += 1;
    }
    b_t0 = daysSince2000();
    until (daysSince2000() - b_t0) * 86400000 >= b_budget {
      k_n += 1;
    }
    b_t1 = daysSince2000();
    b_n = k_n;
    sc_gate = 1;
    wait_until sc_n == 101;
    @bench_round();
  }
  b_chk = b_n;
  @bench_end("sched_waituntil", 1);
}

def @sched_cleanup() {
  broadcast_wait sc_cleanup;
}

def @suite_sched() {
  @sched_looptick();
  @sched_pingpong();
  @sched_restart();
  @sched_clonechurn();
  @sched_spawn();
  @sched_threads();
  @sched_fanout();
  @sched_fanwait();
  @sched_waituntil();
  @sched_cleanup();
}
