def @k_str_join() warp {
  b_n = 0;
  b_t0 = daysSince2000();
  until (daysSince2000() - b_t0) * 86400000 >= b_budget {
    k_s = "";
    repeat 20000 {
      k_s = k_s ++ "ab";
    }
    b_n += 1;
  }
  b_t1 = daysSince2000();
  b_chk = length(k_s);
}

def @k_str_letter() warp {
  k_s = "";
  repeat 100 {
    k_s = k_s ++ "abcdefghij";
  }
  b_n = 0;
  b_t0 = daysSince2000();
  until (daysSince2000() - b_t0) * 86400000 >= b_budget {
    k_i = 0;
    k_acc = 0;
    repeat 10000 {
      k_i += 1;
      if k_s.letter(k_i % 1000 + 1) == "a" {
        k_acc += 1;
      }
    }
    b_n += 1;
  }
  b_t1 = daysSince2000();
  b_chk = k_acc;
}

def @k_str_contains() warp {
  k_s = "";
  repeat 100 {
    k_s = k_s ++ "abcdefghij";
  }
  b_n = 0;
  b_t0 = daysSince2000();
  until (daysSince2000() - b_t0) * 86400000 >= b_budget {
    k_acc = 0;
    repeat 2000 {
      if contains(k_s, "j9") {
        k_acc += 1;
      }
      if contains(k_s, "hij") {
        k_acc += 2;
      }
      k_acc += length(k_s);
    }
    b_n += 1;
  }
  b_t1 = daysSince2000();
  b_chk = k_acc;
}

def @k_str_cast() warp {
  b_n = 0;
  b_t0 = daysSince2000();
  until (daysSince2000() - b_t0) * 86400000 >= b_budget {
    k_i = 0;
    k_acc = 0;
    repeat 5000 {
      k_i += 1;
      k_t = k_i / 4 ++ "";
      k_acc += k_t + 0;
    }
    b_n += 1;
  }
  b_t1 = daysSince2000();
  b_chk = round(k_acc);
}

def @suite_strings() {
  @bench_begin();
  repeat 7 {
    @k_str_join();
    @bench_round();
  }
  @bench_end("str_join", 20000);

  @bench_begin();
  repeat 7 {
    @k_str_letter();
    @bench_round();
  }
  @bench_end("str_letter", 10000);

  @bench_begin();
  repeat 7 {
    @k_str_contains();
    @bench_round();
  }
  @bench_end("str_contains", 2000);

  @bench_begin();
  repeat 7 {
    @k_str_cast();
    @bench_round();
  }
  @bench_end("str_cast", 5000);
}
