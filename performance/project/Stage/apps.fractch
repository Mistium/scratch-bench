// game of life
var lf_x = 0;
var lf_y = 0;
var lf_dx = 0;
var lf_dy = 0;
var lf_n = 0;
var lf_c = 0;
var lf_i = 0;
var lf_a = [];
var lf_b = [];

// brainfuck
var bf_prog = "";
var bf_ip = 0;
var bf_dp = 0;
var bf_c = "";
var bf_j = 0;
var bf_steps = 0;
var bf_tape = [];
var bf_jump = [];
var bf_stack = [];

// raycaster
var rc_posx = 2.5;
var rc_posy = 3.5;
var rc_dx = 0;
var rc_dy = 0;
var rc_plx = 0;
var rc_ply = 0;
var rc_col = 0;
var rc_cam = 0;
var rc_rdx = 0;
var rc_rdy = 0;
var rc_mx = 0;
var rc_my = 0;
var rc_ddx = 0;
var rc_ddy = 0;
var rc_sdx = 0;
var rc_sdy = 0;
var rc_stx = 0;
var rc_sty = 0;
var rc_side = 0;
var rc_hit = 0;
var rc_dist = 0;
var rc_acc = 0;
var rc_x = 0;
var rc_y = 0;
var rc_map = [];

// projection renderer
var pr_f = 0;
var pr_i = 0;
var pr_bit = 0;
var pr_x = 0;
var pr_y = 0;
var pr_z = 0;
var pr_x1 = 0;
var pr_y1 = 0;
var pr_sx = 0;
var pr_sy = 0;
var pr_dx = 0;
var pr_dy = 0;
var pr_err = 0;
var pr_e2 = 0;
var pr_cy = 0;
var pr_sy_ = 0;
var pr_cx = 0;
var pr_sx_ = 0;
var pr_vx = [];
var pr_vy = [];
var pr_vz = [];
var pr_px = [];
var pr_py = [];
var pr_ea = [];
var pr_eb = [];
var pr_buf = [];

// expression parser
var ast_src = "";
var ast_pos = 0;
var ast_c = "";
var ast_r = 0;
var ast_v = 0;
var ast_t = [];
var ast_a = [];
var ast_b = [];

def @k_app_life() warp {
  clear(lf_a);
  clear(lf_b);
  repeat 144 {
    append(lf_a, 0);
    append(lf_b, 0);
  }
  b_n = 0;
  b_t0 = daysSince2000();
  until (daysSince2000() - b_t0) * 86400000 >= b_budget {
    k_seed = 4242;
    lf_i = 0;
    repeat 144 {
      k_seed = k_seed * 16807 % 2147483647;
      lf_i += 1;
      if k_seed % 3 == 0 {
        lists["lf_a"][lf_i] = 1;
      } else {
        lists["lf_a"][lf_i] = 0;
      }
    }
    repeat 4 {
      lf_y = 0;
      repeat 12 {
        lf_x = 0;
        repeat 12 {
          lf_n = 0;
          lf_dy = -1;
          repeat 3 {
            lf_dx = -1;
            repeat 3 {
              if lf_dx != 0 || lf_dy != 0 {
                lf_n += lists["lf_a"][(lf_y + lf_dy + 12) % 12 * 12 + (lf_x + lf_dx + 12) % 12 + 1];
              }
              lf_dx += 1;
            }
            lf_dy += 1;
          }
          lf_c = lists["lf_a"][lf_y * 12 + lf_x + 1];
          if lf_n == 3 || (lf_c == 1 && lf_n == 2) {
            lists["lf_b"][lf_y * 12 + lf_x + 1] = 1;
          } else {
            lists["lf_b"][lf_y * 12 + lf_x + 1] = 0;
          }
          lf_x += 1;
        }
        lf_y += 1;
      }
      lf_i = 0;
      repeat 144 {
        lf_i += 1;
        lists["lf_a"][lf_i] = lists["lf_b"][lf_i];
      }
    }
    b_n += 1;
  }
  b_t1 = daysSince2000();
  lf_n = 0;
  lf_i = 0;
  repeat 144 {
    lf_i += 1;
    lf_n += lists["lf_a"][lf_i];
  }
  b_chk = lf_n;
}

def @k_app_brainfuck() warp {
  bf_prog = "+++++[>+++++[>+++++[>+<-]<-]<-]";
  b_n = 0;
  b_t0 = daysSince2000();
  until (daysSince2000() - b_t0) * 86400000 >= b_budget {
    clear(bf_tape);
    clear(bf_jump);
    clear(bf_stack);
    repeat 8 {
      append(bf_tape, 0);
    }
    bf_ip = 0;
    repeat length(bf_prog) {
      bf_ip += 1;
      append(bf_jump, 0);
      bf_c = bf_prog.letter(bf_ip);
      if bf_c == "[" {
        append(bf_stack, bf_ip);
      }
      if bf_c == "]" {
        bf_j = lists["bf_stack"][lists["bf_stack"].length];
        lists["bf_stack"].delete(lists["bf_stack"].length);
        lists["bf_jump"][bf_ip] = bf_j;
        lists["bf_jump"][bf_j] = bf_ip;
      }
    }
    bf_ip = 1;
    bf_dp = 1;
    bf_steps = 0;
    until bf_ip > length(bf_prog) {
      bf_c = bf_prog.letter(bf_ip);
      if bf_c == "+" {
        lists["bf_tape"][bf_dp] = (lists["bf_tape"][bf_dp] + 1) % 256;
      } else if bf_c == "-" {
        lists["bf_tape"][bf_dp] = (lists["bf_tape"][bf_dp] + 255) % 256;
      } else if bf_c == ">" {
        bf_dp += 1;
      } else if bf_c == "<" {
        bf_dp -= 1;
      } else if bf_c == "[" {
        if lists["bf_tape"][bf_dp] == 0 {
          bf_ip = lists["bf_jump"][bf_ip];
        }
      } else if bf_c == "]" {
        if lists["bf_tape"][bf_dp] != 0 {
          bf_ip = lists["bf_jump"][bf_ip];
        }
      }
      bf_ip += 1;
      bf_steps += 1;
    }
    b_n += 1;
  }
  b_t1 = daysSince2000();
  b_chk = bf_steps * 1000 + lists["bf_tape"][4];
}

def @k_app_raycast() warp {
  clear(rc_map);
  rc_y = 0;
  repeat 8 {
    rc_x = 0;
    repeat 8 {
      if rc_x == 0 || rc_x == 7 || rc_y == 0 || rc_y == 7 || (rc_x == 5 && rc_y >= 2 && rc_y <= 4) || (rc_x == 3 && rc_y == 5) {
        append(rc_map, 1);
      } else {
        append(rc_map, 0);
      }
      rc_x += 1;
    }
    rc_y += 1;
  }
  b_n = 0;
  b_t0 = daysSince2000();
  until (daysSince2000() - b_t0) * 86400000 >= b_budget {
    rc_dx = operator.mathop(NUM: 17, field OPERATOR: "cos");
    rc_dy = operator.mathop(NUM: 17, field OPERATOR: "sin");
    rc_plx = 0 - rc_dy * 0.66;
    rc_ply = rc_dx * 0.66;
    rc_acc = 0;
    rc_col = 0;
    repeat 320 {
      rc_cam = 2 * rc_col / 320 - 1;
      rc_rdx = rc_dx + rc_plx * rc_cam;
      rc_rdy = rc_dy + rc_ply * rc_cam;
      rc_mx = floor(rc_posx);
      rc_my = floor(rc_posy);
      if rc_rdx == 0 {
        rc_ddx = 1000000000;
      } else {
        rc_ddx = abs(1 / rc_rdx);
      }
      if rc_rdy == 0 {
        rc_ddy = 1000000000;
      } else {
        rc_ddy = abs(1 / rc_rdy);
      }
      if rc_rdx < 0 {
        rc_stx = -1;
        rc_sdx = (rc_posx - rc_mx) * rc_ddx;
      } else {
        rc_stx = 1;
        rc_sdx = (rc_mx + 1 - rc_posx) * rc_ddx;
      }
      if rc_rdy < 0 {
        rc_sty = -1;
        rc_sdy = (rc_posy - rc_my) * rc_ddy;
      } else {
        rc_sty = 1;
        rc_sdy = (rc_my + 1 - rc_posy) * rc_ddy;
      }
      rc_hit = 0;
      until rc_hit == 1 {
        if rc_sdx < rc_sdy {
          rc_sdx += rc_ddx;
          rc_mx += rc_stx;
          rc_side = 0;
        } else {
          rc_sdy += rc_ddy;
          rc_my += rc_sty;
          rc_side = 1;
        }
        if lists["rc_map"][rc_my * 8 + rc_mx + 1] != 0 {
          rc_hit = 1;
        }
      }
      if rc_side == 0 {
        rc_dist = rc_sdx - rc_ddx;
      } else {
        rc_dist = rc_sdy - rc_ddy;
      }
      rc_acc += floor(200 / rc_dist);
      rc_col += 1;
    }
    b_n += 1;
  }
  b_t1 = daysSince2000();
  b_chk = rc_acc;
}

def @k_app_projection() warp {
  clear(pr_vx);
  clear(pr_vy);
  clear(pr_vz);
  clear(pr_px);
  clear(pr_py);
  clear(pr_ea);
  clear(pr_eb);
  clear(pr_buf);
  pr_i = 0;
  repeat 8 {
    append(pr_vx, pr_i % 2 * 2 - 1);
    append(pr_vy, floor(pr_i / 2) % 2 * 2 - 1);
    append(pr_vz, floor(pr_i / 4) * 2 - 1);
    append(pr_px, 0);
    append(pr_py, 0);
    pr_i += 1;
  }
  pr_i = 0;
  repeat 8 {
    pr_bit = 1;
    repeat 3 {
      if floor(pr_i / pr_bit) % 2 == 0 {
        append(pr_ea, pr_i + 1);
        append(pr_eb, pr_i + pr_bit + 1);
      }
      pr_bit = pr_bit * 2;
    }
    pr_i += 1;
  }
  repeat 576 {
    append(pr_buf, 0);
  }
  b_n = 0;
  b_t0 = daysSince2000();
  until (daysSince2000() - b_t0) * 86400000 >= b_budget {
    pr_f = 0;
    repeat 4 {
      pr_i = 0;
      repeat 576 {
        pr_i += 1;
        lists["pr_buf"][pr_i] = 0;
      }
      pr_cy = operator.mathop(NUM: 20 + 25 * pr_f, field OPERATOR: "cos");
      pr_sy_ = operator.mathop(NUM: 20 + 25 * pr_f, field OPERATOR: "sin");
      pr_cx = operator.mathop(NUM: 15 + 10 * pr_f, field OPERATOR: "cos");
      pr_sx_ = operator.mathop(NUM: 15 + 10 * pr_f, field OPERATOR: "sin");
      pr_i = 1;
      repeat 8 {
        pr_x = lists["pr_vx"][pr_i] * pr_cy + lists["pr_vz"][pr_i] * pr_sy_;
        pr_z = lists["pr_vz"][pr_i] * pr_cy - lists["pr_vx"][pr_i] * pr_sy_;
        pr_y = lists["pr_vy"][pr_i] * pr_cx - pr_z * pr_sx_;
        pr_z = lists["pr_vy"][pr_i] * pr_sx_ + pr_z * pr_cx + 4;
        lists["pr_px"][pr_i] = floor(12 + 14 * pr_x / pr_z);
        lists["pr_py"][pr_i] = floor(12 - 14 * pr_y / pr_z);
        pr_i += 1;
      }
      pr_i = 1;
      repeat 12 {
        pr_x = lists["pr_px"][lists["pr_ea"][pr_i]];
        pr_y = lists["pr_py"][lists["pr_ea"][pr_i]];
        pr_x1 = lists["pr_px"][lists["pr_eb"][pr_i]];
        pr_y1 = lists["pr_py"][lists["pr_eb"][pr_i]];
        pr_dx = abs(pr_x1 - pr_x);
        pr_dy = 0 - abs(pr_y1 - pr_y);
        pr_sx = -1;
        if pr_x < pr_x1 {
          pr_sx = 1;
        }
        pr_sy = -1;
        if pr_y < pr_y1 {
          pr_sy = 1;
        }
        pr_err = pr_dx + pr_dy;
        until pr_x == pr_x1 && pr_y == pr_y1 {
          if pr_x >= 0 && pr_x < 24 && pr_y >= 0 && pr_y < 24 {
            lists["pr_buf"][pr_y * 24 + pr_x + 1] = 1;
          }
          pr_e2 = 2 * pr_err;
          if pr_e2 >= pr_dy {
            pr_err += pr_dy;
            pr_x += pr_sx;
          }
          if pr_e2 <= pr_dx {
            pr_err += pr_dx;
            pr_y += pr_sy;
          }
        }
        if pr_x >= 0 && pr_x < 24 && pr_y >= 0 && pr_y < 24 {
          lists["pr_buf"][pr_y * 24 + pr_x + 1] = 1;
        }
        pr_i += 1;
      }
      pr_f += 1;
    }
    b_n += 1;
  }
  b_t1 = daysSince2000();
  pr_x = 0;
  pr_i = 0;
  repeat 576 {
    pr_i += 1;
    pr_x += lists["pr_buf"][pr_i];
  }
  b_chk = pr_x;
}

def @ast_peek() warp {
  ast_c = ast_src.letter(ast_pos);
}

def @ast_node(type, a, b) warp {
  append(ast_t, arg("type"));
  append(ast_a, arg("a"));
  append(ast_b, arg("b"));
  ast_r = lists["ast_t"].length;
}

def @ast_expr() warp {
  @ast_term();
  @ast_expr_tail(ast_r);
}

def @ast_expr_tail(left) warp {
  @ast_peek();
  if ast_c == "+" {
    ast_pos += 1;
    @ast_add_rhs(arg("left"), 1);
  } else if ast_c == "-" {
    ast_pos += 1;
    @ast_add_rhs(arg("left"), 2);
  } else {
    ast_r = arg("left");
  }
}

def @ast_add_rhs(left, op) warp {
  @ast_term();
  @ast_node(arg("op"), arg("left"), ast_r);
  @ast_expr_tail(ast_r);
}

def @ast_term() warp {
  @ast_factor();
  @ast_term_tail(ast_r);
}

def @ast_term_tail(left) warp {
  @ast_peek();
  if ast_c == "*" {
    ast_pos += 1;
    @ast_mul_rhs(arg("left"), 3);
  } else if ast_c == "/" {
    ast_pos += 1;
    @ast_mul_rhs(arg("left"), 4);
  } else if ast_c == "%" {
    ast_pos += 1;
    @ast_mul_rhs(arg("left"), 5);
  } else {
    ast_r = arg("left");
  }
}

def @ast_mul_rhs(left, op) warp {
  @ast_factor();
  @ast_node(arg("op"), arg("left"), ast_r);
  @ast_term_tail(ast_r);
}

def @ast_factor() warp {
  @ast_peek();
  if ast_c == "(" {
    ast_pos += 1;
    @ast_expr();
    ast_pos += 1;
  } else if ast_c == "-" {
    ast_pos += 1;
    @ast_factor();
    @ast_node(6, ast_r, 0);
  } else {
    ast_v = 0;
    until ast_c == "" || !contains("0123456789", ast_c) {
      ast_v = ast_v * 10 + ast_c;
      ast_pos += 1;
      @ast_peek();
    }
    @ast_node(0, ast_v, 0);
  }
}

def @ast_eval(n) warp {
  if lists["ast_t"][arg("n")] == 0 {
    ast_r = lists["ast_a"][arg("n")];
  } else if lists["ast_t"][arg("n")] == 6 {
    @ast_eval(lists["ast_a"][arg("n")]);
    ast_r = 0 - ast_r;
  } else {
    @ast_eval(lists["ast_a"][arg("n")]);
    @ast_bin(lists["ast_t"][arg("n")], ast_r, lists["ast_b"][arg("n")]);
  }
}

def @ast_bin(op, l, rn) warp {
  @ast_eval(arg("rn"));
  if arg("op") == 1 {
    ast_r = arg("l") + ast_r;
  } else if arg("op") == 2 {
    ast_r = arg("l") - ast_r;
  } else if arg("op") == 3 {
    ast_r = arg("l") * ast_r;
  } else if arg("op") == 4 {
    ast_r = arg("l") / ast_r;
  } else {
    ast_r = arg("l") % ast_r;
  }
}

def @k_app_ast() warp {
  ast_src = "(1+2)*3-4/(5-3)+6*(7+8*(9-2))-(10%4)*-3+12";
  b_n = 0;
  b_t0 = daysSince2000();
  until (daysSince2000() - b_t0) * 86400000 >= b_budget {
    repeat 3 {
      clear(ast_t);
      clear(ast_a);
      clear(ast_b);
      ast_pos = 1;
      @ast_expr();
      @ast_eval(ast_r);
    }
    b_n += 1;
  }
  b_t1 = daysSince2000();
  b_chk = ast_r;
}

def @suite_apps() {
  @bench_begin();
  repeat 7 {
    @k_app_life();
    @bench_round();
  }
  @bench_end("app_life", 576);

  @bench_begin();
  repeat 7 {
    @k_app_brainfuck();
    @bench_round();
  }
  @bench_end("app_brainfuck", 931);

  @bench_begin();
  repeat 7 {
    @k_app_raycast();
    @bench_round();
  }
  @bench_end("app_raycast", 320);

  @bench_begin();
  repeat 7 {
    @k_app_projection();
    @bench_round();
  }
  @bench_end("app_projection", 4);

  @bench_begin();
  repeat 7 {
    @k_app_ast();
    @bench_round();
  }
  @bench_end("app_ast", 126);
}
